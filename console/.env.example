# Copy to .env.local and fill in once the Supabase project exists.
# Until these are set, the console runs on seeded local data (localStorage).
#
# SAFE to put here: the anon/public key. It is designed to ship in the browser
# and is useless without the RLS policies in supabase/migrations.
# NEVER put the service_role key in this file or anywhere in the frontend —
# it bypasses RLS entirely.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
