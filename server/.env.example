# Copy to .env if you need to override defaults. All values are optional.
# This server only serves static files now — auth and data live on Supabase.

NODE_ENV=development
PORT=8420

# The Supabase project origin allowed in the Content-Security-Policy's
# connect-src (so the browser client can reach Auth + REST). Defaults to the
# project baked into public/js/supabase-config.js.
SUPABASE_ORIGIN=https://mjkkrgpntlqbioevxdvw.supabase.co

# --- Partner booking integration (webhook receiver) -------------------------
# Shared secret a partner must send as the `x-playmetric-secret` header.
# Change this from the default before exposing the endpoint anywhere.
PLAYMETRIC_WEBHOOK_SECRET=dev-secret

# Needed ONLY by POST /api/webhooks/bookings, which writes bookings server-side.
# ⚠️  service_role bypasses RLS entirely — keep it server-side, never in the
#     console bundle, never in git. Supabase → Project Settings → API.
#     Leave unset and the webhook returns a clear 503 instead of failing oddly.
# SUPABASE_URL=https://mjkkrgpntlqbioevxdvw.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
