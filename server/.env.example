# Copy to .env if you need to override defaults. All values are optional.
# This server only serves static files now — auth and data live on Supabase.

NODE_ENV=development
PORT=8420

# The Supabase project origin allowed in the Content-Security-Policy's
# connect-src (so the browser client can reach Auth + REST). Defaults to the
# project baked into public/js/supabase-config.js.
SUPABASE_ORIGIN=https://mjkkrgpntlqbioevxdvw.supabase.co
