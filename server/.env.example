# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=8420

# MongoDB connection string (local dev default shown)
MONGODB_URI=mongodb://127.0.0.1:27017/playmetric

# Long random secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-value
CSRF_SECRET=replace-with-a-different-long-random-value

# Comma-separated list of origins allowed to call the API (same-origin site doesn't need this,
# only set if the frontend is ever served from a different origin)
ALLOWED_ORIGINS=http://localhost:8420

# Used only by scripts/seedAdmin.js to create the first admin account.
# Remove from .env after the first successful seed run.
SEED_ADMIN_EMAIL=owner@playmetric.in
SEED_ADMIN_PASSWORD=change-this-before-seeding
